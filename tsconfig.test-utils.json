{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false,
    "outDir": "./dist/test-utils",
    "rootDir": "./src/test-utils"
  },
  "include": ["src/test-utils/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
